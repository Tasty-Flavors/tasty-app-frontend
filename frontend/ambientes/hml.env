# Ambiente de homologação: npm run dev:hml | npm run build:hml
# Valores pessoais (como o token) ficam em hml.local.env, que não vai para o git.

# URL do BFF do painel (preencha com a URL de homologação)
NEXT_PUBLIC_API_URL=
# URL do serviço de autenticação (preencha com a URL de homologação)
NEXT_PUBLIC_AUTH_URL=
# Token fixo enviado ao BFF quando não há login feito (vazio = exige login)
NEXT_PUBLIC_ACCESS_TOKEN=
# true = usa os dados fictícios de src/mocks; false = chama o BFF
NEXT_PUBLIC_USE_MOCKS=false
