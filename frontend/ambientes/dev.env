# Ambiente de desenvolvimento: npm run dev | npm run build:dev
# Valores pessoais (como o token) ficam em dev.local.env, que não vai para o git.

# URL do BFF do painel
NEXT_PUBLIC_API_URL=http://localhost:8081/tasty-app-bff
# URL do serviço de autenticação (login)
NEXT_PUBLIC_AUTH_URL=http://localhost:8085/tasty-auth-service
# Token fixo enviado ao BFF quando não há login feito (vazio = exige login)
NEXT_PUBLIC_ACCESS_TOKEN=
# true = usa os dados fictícios de src/mocks; false = chama o BFF
NEXT_PUBLIC_USE_MOCKS=true
