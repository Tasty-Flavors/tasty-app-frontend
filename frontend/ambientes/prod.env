# Ambiente de produção: npm run dev:prod | npm run build:prod (ou npm run build)

# URL do BFF do painel
NEXT_PUBLIC_API_URL=https://tasty-app-bff.fly.dev/tasty-app-bff
# URL do serviço de autenticação (login)
NEXT_PUBLIC_AUTH_URL=https://tasty-auth-service.fly.dev/tasty-auth-service
# Token fixo: em produção, deixe vazio. Ele iria no JavaScript entregue a todos os visitantes.
NEXT_PUBLIC_ACCESS_TOKEN=
# true = usa os dados fictícios de src/mocks; false = chama o BFF
NEXT_PUBLIC_USE_MOCKS=false
# true = login e cadastro fictícios, sem servidor; false = chama o serviço de autenticação
NEXT_PUBLIC_USE_AUTH_MOCKS=false
