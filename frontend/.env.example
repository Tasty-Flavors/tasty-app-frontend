# Os ambientes ficam em ambientes/dev.env, hml.env e prod.env.
# Para valores só seus (como o token), crie ambientes/<ambiente>.local.env com as
# variáveis abaixo: esse arquivo tem prioridade e não vai para o git.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_URL=
NEXT_PUBLIC_ACCESS_TOKEN=
NEXT_PUBLIC_USE_MOCKS=true
